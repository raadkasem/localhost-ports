{
  "manifest_version": 3,
  "name": "Localhost Ports Dashboard",
  "version": "1.2.1",
  "description": "Find HTTP(S) services on common and saved localhost ports, then open them with one click.",
  "author": "Raad Kasem",
  "homepage_url": "https://raadkasem.dev",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://0.0.0.0/*",
    "https://0.0.0.0/*",
    "http://[::1]/*",
    "https://[::1]/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Localhost Ports Dashboard"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
